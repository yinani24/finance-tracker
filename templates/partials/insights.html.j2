{# Insights tab: health score, lifestyle insights, actionable cuts, action plan #}
<div x-show="tab==='insights'" x-cloak>

  {# Health Score #}
  <div class="fin-card" style="margin-bottom:16px">
    <div class="fin-card-body">
      <div style="display:flex;align-items:center;gap:20px;margin-bottom:16px">
        <div style="position:relative;flex-shrink:0">
          <canvas id="healthChart" style="width:80px;height:80px"></canvas>
          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center">
            <div style="font-size:1.3rem;font-weight:800;letter-spacing:-0.03em;color:{% if health.score >= 80 %}var(--c-success){% elif health.score >= 60 %}var(--c-warning){% else %}var(--c-error){% endif %}">{{ health.grade }}</div>
          </div>
        </div>
        <div>
          <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--c-muted);margin-bottom:4px">Financial Health Score</div>
          <div style="font-size:1.8rem;font-weight:800;letter-spacing:-0.04em;font-feature-settings:'tnum';color:{% if health.score >= 80 %}var(--c-success){% elif health.score >= 60 %}var(--c-warning){% else %}var(--c-error){% endif %}">{{ health.score }}<span style="font-size:0.85rem;color:var(--c-muted);font-weight:400"> / 100</span></div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:0">
        {% for dim in health.dimensions %}
        <div style="display:flex;align-items:center;gap:0;padding:10px 0;{% if not loop.last %}border-bottom:1px solid var(--c-border){% endif %}">
          <div style="width:150px;font-size:0.78rem;font-weight:600;flex-shrink:0;display:flex;align-items:center;gap:8px">
            {% if dim.status == 'pass' %}
            <div style="width:6px;height:6px;border-radius:50%;background:var(--c-success);flex-shrink:0"></div>
            {% elif dim.status == 'warn' %}
            <div style="width:6px;height:6px;border-radius:50%;background:var(--c-warning);flex-shrink:0"></div>
            {% else %}
            <div style="width:6px;height:6px;border-radius:50%;background:var(--c-error);flex-shrink:0"></div>
            {% endif %}
            {{ dim.label }}
          </div>
          <div style="width:60px;text-align:right;font-size:0.78rem;font-weight:800;font-feature-settings:'tnum';color:{% if dim.status == 'pass' %}var(--c-success){% elif dim.status == 'warn' %}var(--c-warning){% else %}var(--c-error){% endif %};flex-shrink:0">{{ dim.score }}/{{ dim.max }}</div>
          <div style="font-size:0.75rem;color:var(--c-muted);padding-left:16px;flex:1">{{ dim.explanation }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  {# Lifestyle Insights #}
  {% if lifestyle_insights %}
  <div class="fin-card" style="margin-bottom:16px">
    <div class="fin-card-body">
      <div class="section-label">Lifestyle Insights</div>
      {% for insight in lifestyle_insights %}
      <div style="display:flex;gap:12px;align-items:flex-start;{% if not loop.last %}margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--c-border){% endif %}">
        <div style="width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:var(--c-warning-light);flex-shrink:0;margin-top:0">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
        </div>
        <div style="font-size:0.82rem;line-height:1.6;padding-top:4px">{{ insight }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# Actionable Cuts #}
  {% if cuts %}
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <div class="section-label" style="margin-bottom:0">Actionable Cuts</div>
    <div style="font-size:0.75rem;color:var(--c-success);font-weight:700;font-feature-settings:'tnum'">
      Potential: ${{ cuts | sum(attribute='potential_saving') | format_currency }}/mo
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px">
    {% for cut in cuts %}
    <div class="fin-card" style="padding:14px 18px">
      <div style="display:flex;align-items:center;gap:14px">
        <div style="width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--c-error-light);flex-shrink:0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-error)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div style="flex:1">
          <div style="font-size:0.82rem;font-weight:700;margin-bottom:3px;letter-spacing:-0.01em">{{ cut.description }}</div>
          <div style="font-size:0.75rem;color:var(--c-muted)">{{ cut.detail }}</div>
        </div>
        <div style="font-size:0.85rem;font-weight:800;color:var(--c-success);flex-shrink:0;white-space:nowrap;font-feature-settings:'tnum'">
          +${{ cut.potential_saving | format_currency }}/mo
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div style="border-top:1px solid var(--c-border);margin:20px 0"></div>

  {# Action Plan #}
  {% if action_plan %}
  <div class="fin-card">
    <div class="fin-card-body">
      <div class="section-label">Your Action Plan</div>
      {% for step in action_plan %}
      <div style="display:flex;gap:14px;align-items:flex-start;{% if not loop.last %}margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--c-border){% endif %}">
        <div style="width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:800;flex-shrink:0;
          {% if loop.index == 1 %}background:var(--c-error-light);border:1px solid var(--c-error-border);color:var(--c-error)
          {% elif loop.index == 2 %}background:var(--c-warning-light);border:1px solid var(--c-warning-border);color:var(--c-warning)
          {% else %}background:var(--c-success-light);border:1px solid var(--c-success-border);color:var(--c-success){% endif %}">
          {{ step.step }}
        </div>
        <div>
          <div style="font-size:0.82rem;font-weight:700;margin-bottom:3px;letter-spacing:-0.01em">{{ step.month_label }} -- {{ step.action }}</div>
          <div style="font-size:0.75rem;color:var(--c-muted);line-height:1.5">{{ step.description }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="fin-card" style="padding:20px">
    <div style="font-size:0.82rem;color:var(--c-muted)">
      No actionable cuts found -- your spending looks well-controlled.
    </div>
  </div>
  {% endif %}

</div>
