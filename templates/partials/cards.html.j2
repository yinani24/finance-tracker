{# Cards tab: CSP analysis, card portfolio, category optimizer, upgrade picks #}
<div x-show="tab==='cards'" x-cloak>

  {# CSP Deep Dive #}
  {% if csp_analysis %}
  <div class="fin-card" style="margin-bottom:16px">
    <div class="fin-card-body">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <div class="section-label" style="margin-bottom:0">Chase Sapphire Preferred -- Earn Analysis</div>
        <div style="font-size:0.75rem;font-feature-settings:'tnum'">
          <span style="color:var(--c-success);font-weight:800">${{ csp_analysis.net_annual_value | format_currency }}/yr net</span>
          <span style="color:var(--c-muted);margin-left:6px">(after ${{ csp_analysis.annual_fee }} fee)</span>
        </div>
      </div>
      {% if csp_analysis.top_opportunity %}
      <div style="padding:10px 14px;margin-bottom:12px;font-size:0.78rem;background:var(--c-bg);border-radius:10px;display:flex;align-items:center;gap:8px;border:1px solid var(--c-border)">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--c-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        <span>{{ csp_analysis.top_opportunity }}</span>
      </div>
      {% endif %}
      <table class="table table-zebra table-sm">
        <thead><tr><th>Category</th><th style="text-align:right">Monthly</th><th style="text-align:center">Rate</th><th style="text-align:right">Annual Value</th></tr></thead>
        <tbody>
          {% for row in csp_analysis.by_category %}
          <tr>
            <td style="font-size:0.78rem;font-weight:500">{{ row.category }}{% if row.note %} <span style="font-size:0.65rem;color:var(--c-secondary);margin-left:4px;font-weight:600">{{ row.note }}</span>{% endif %}</td>
            <td style="text-align:right;color:var(--c-muted);font-feature-settings:'tnum'">${{ row.monthly_spend | format_currency }}</td>
            <td style="text-align:center;font-weight:700;font-feature-settings:'tnum';color:{% if row.earn_rate != '1x' %}var(--c-success){% else %}var(--c-muted){% endif %}">{{ row.earn_rate }}</td>
            <td style="text-align:right;font-weight:700;font-feature-settings:'tnum'">${{ row.annual_value | format_currency }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div style="font-size:0.72rem;color:var(--c-muted);margin-top:10px">{{ csp_analysis.fx_note }}</div>
    </div>
  </div>
  {% endif %}

  {% if card_intel.has_cards %}

    {# Card Portfolio #}
    <div class="fin-card" style="margin-bottom:16px">
      <div class="fin-card-body">
        <div class="section-label">Card Portfolio</div>
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th>Card</th>
              <th style="text-align:right">Gross Rewards/yr</th>
              <th style="text-align:right">Annual Fee</th>
              <th style="text-align:right">Net Value/yr</th>
            </tr>
          </thead>
          <tbody>
            {% for cv in card_intel.card_values %}
            <tr>
              <td style="font-weight:600;letter-spacing:-0.01em">{{ cv.name }}</td>
              <td style="text-align:right;color:var(--c-success);font-weight:700;font-feature-settings:'tnum'">${{ cv.gross_rewards | format_currency }}</td>
              <td style="text-align:right;color:var(--c-muted);font-feature-settings:'tnum'">${{ cv.annual_fee | format_currency }}</td>
              <td style="text-align:right;font-weight:800;font-feature-settings:'tnum';color:{% if cv.net_value >= 0 %}var(--c-success){% else %}var(--c-error){% endif %}">${{ cv.net_value | format_currency }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# Missed Rewards Callout #}
    {% if card_intel.missed_rewards_annual > 0 %}
    <div class="fin-card" style="border:1px solid var(--c-warning-border);background:var(--c-warning-light);padding:14px 18px;margin-bottom:16px">
      <div style="display:flex;align-items:center;gap:14px">
        <div style="width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--c-warning-border);flex-shrink:0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
        </div>
        <div>
          <div style="font-size:0.85rem;font-weight:700;margin-bottom:3px;letter-spacing:-0.01em">Missed Rewards Opportunity</div>
          <div style="font-size:0.78rem;color:var(--c-muted)">You could earn up to <strong style="color:var(--c-warning);font-feature-settings:'tnum'">${{ card_intel.missed_rewards_annual | format_currency }}/yr</strong> more by using the best card for each category.</div>
        </div>
      </div>
    </div>
    {% endif %}

    {# Category Optimizer #}
    {% if card_intel.optimal_per_category %}
    <div class="fin-card" style="margin-bottom:16px">
      <div class="fin-card-body">
        <div class="section-label">Category Optimizer -- Best Card Per Spend</div>
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th>Category</th>
              <th>Best Card</th>
              <th style="text-align:right">Effective %</th>
              <th style="text-align:right">Annual Gain</th>
            </tr>
          </thead>
          <tbody>
            {% for row in card_intel.optimal_per_category %}
            <tr>
              <td><span class="badge badge-outline badge-sm" style="font-weight:600">{{ row.category }}</span></td>
              <td style="font-weight:600;letter-spacing:-0.01em">{{ row.best_card }}</td>
              <td style="text-align:right;color:var(--c-muted);font-feature-settings:'tnum'">{{ "%.1f" | format(row.effective_pct) }}%</td>
              <td style="text-align:right;font-weight:800;color:var(--c-success);font-feature-settings:'tnum'">${{ row.annual_gain | format_currency }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endif %}

    {# Upgrade Recommendations #}
    {% if card_intel.upgrade_recommendations %}
    <div class="fin-card">
      <div class="fin-card-body">
        <div class="section-label">Upgrade Picks</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          {% for rec in card_intel.upgrade_recommendations %}
          <div style="border:1px solid var(--c-success-border);background:var(--c-success-light);padding:14px 18px;border-radius:12px;transition:box-shadow 0.3s cubic-bezier(0.16,1,0.3,1)">
            <div style="display:flex;align-items:center;gap:14px">
              <div style="width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--c-card);border:1px solid var(--c-success-border);flex-shrink:0">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div style="flex:1">
                <div style="font-size:0.85rem;font-weight:700;margin-bottom:3px;letter-spacing:-0.01em">{{ rec.name }}
                  <span style="font-size:0.72rem;color:var(--c-muted);font-weight:500;margin-left:4px">${{ rec.annual_fee | format_currency }}/yr fee</span>
                </div>
                <div style="font-size:0.75rem;color:var(--c-muted);line-height:1.5">{{ rec.why }}</div>
              </div>
              <div style="text-align:right;flex-shrink:0">
                <div style="font-size:0.88rem;font-weight:800;color:var(--c-success);font-feature-settings:'tnum'">+${{ rec.gain_over_best | format_currency }}/yr</div>
                <div style="font-size:0.68rem;color:var(--c-muted)">vs your best card</div>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

  {% else %}

    {# Empty State #}
    <div class="fin-card" style="text-align:center;padding:56px 24px">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.12;margin:0 auto 14px;display:block"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
      <div style="font-size:1rem;font-weight:700;margin-bottom:8px;letter-spacing:-0.02em">No Cards Configured</div>
      <div style="font-size:0.82rem;color:var(--c-muted);max-width:380px;margin:0 auto;line-height:1.6">
        Add your credit cards to unlock reward optimization, category analysis, and upgrade recommendations.
      </div>
      <div style="margin-top:18px;padding:10px 18px;background:var(--c-bg);border-radius:10px;font-size:0.75rem;color:var(--c-muted);display:inline-block;text-align:left;border:1px solid var(--c-border)">
        Copy <code style="font-weight:600">data/cards.example.json</code> &rarr; <code style="font-weight:600">data/cards.json</code> and fill in your cards.
      </div>
    </div>

  {% endif %}
</div>
