#!/usr/bin/env bash
#
# Pre-commit hook: block commits containing secrets or sensitive data.
# Install: git config core.hooksPath .githooks
#

set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'

# Patterns that indicate real secrets (not placeholder values like "your-xxx")
SECRET_PATTERNS=(
  # API keys with real-looking values
  'sk_live_[a-zA-Z0-9]{20,}'
  'sk_test_[a-zA-Z0-9]{20,}'
  'ghp_[a-zA-Z0-9]{36,}'
  'gho_[a-zA-Z0-9]{36,}'
  'AKIA[A-Z0-9]{16}'
  # Private keys
  '-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'
  # JWTs (three base64 sections separated by dots)
  'eyJ[a-zA-Z0-9_-]{20,}\.[a-zA-Z0-9_-]{20,}\.[a-zA-Z0-9_-]{20,}'
  # Supabase service role keys (always start with eyJ)
  'service_role.*eyJ[a-zA-Z0-9_-]{20,}'
  # Generic long hex/base64 secrets assigned to variables
  '(api_key|secret_key|api_secret|access_token|auth_token)\s*[=:]\s*["\x27][a-zA-Z0-9/+=_-]{32,}["\x27]'
)

# Files to always block
BLOCKED_FILES=(
  '.env.local'
  '.env.production'
  '.env.development'
  '*.pem'
  '*.key'
  'credentials.json'
  'service-account*.json'
)

ERRORS=0

# Check staged files for blocked filenames
for pattern in "${BLOCKED_FILES[@]}"; do
  matches=$(git diff --cached --name-only --diff-filter=ACM | grep -E "(^|/)${pattern}$" 2>/dev/null || true)
  if [[ -n "$matches" ]]; then
    echo -e "${RED}BLOCKED:${NC} Sensitive file staged for commit:"
    echo "$matches"
    ERRORS=$((ERRORS + 1))
  fi
done

# Check staged diff content for secret patterns
STAGED_DIFF=$(git diff --cached --diff-filter=ACM -U0 -- . ':!*.pdf' ':!*.png' ':!*.jpg' ':!*.ico' ':!*.woff2' ':!*.lock' 2>/dev/null || true)

if [[ -n "$STAGED_DIFF" ]]; then
  for pattern in "${SECRET_PATTERNS[@]}"; do
    matches=$(echo "$STAGED_DIFF" | grep -En "$pattern" 2>/dev/null | head -5 || true)
    if [[ -n "$matches" ]]; then
      echo -e "${RED}BLOCKED:${NC} Potential secret detected matching pattern: $pattern"
      echo "$matches"
      ERRORS=$((ERRORS + 1))
    fi
  done
fi

if [[ $ERRORS -gt 0 ]]; then
  echo ""
  echo -e "${RED}Commit blocked.${NC} Remove secrets before committing."
  echo "If this is a false positive, use: git commit --no-verify"
  exit 1
fi

exit 0
