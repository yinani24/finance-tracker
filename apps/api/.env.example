FT_DATABASE_URL=postgresql://localhost:5432/finance_tracker
FT_SUPABASE_JWT_SECRET=your-supabase-jwt-secret
FT_AUTH_DISABLED=false
FT_PLAID_CLIENT_ID=your-plaid-client-id
FT_PLAID_SECRET=your-plaid-secret
FT_PLAID_ENV=sandbox
# Public URL Plaid calls for webhooks (leave blank for local/sandbox without a public URL)
FT_PLAID_WEBHOOK_URL=
# OAuth redirect URI — REQUIRED to link OAuth banks (Chase, BofA, Wells Fargo, …).
# Must exactly match an Allowed redirect URI in the Plaid Dashboard AND the page
# hosting Plaid Link (e.g. https://yourapp.com/settings). Blank = OAuth banks fail.
FT_PLAID_REDIRECT_URI=
# Verify the Plaid-Verification JWT on inbound webhooks. Keep true in any
# deployed/production setting; set false only for local testing without a real JWT.
FT_PLAID_WEBHOOK_VERIFY=true
FT_ANTHROPIC_API_KEY=your-anthropic-api-key
# Transaction-enrichment provider. "noop" (default) keeps Plaid's raw category;
# a real provider (e.g. "ntropy") is wired in a later slice once a key exists.
FT_ENRICHMENT_PROVIDER=noop
